{%- from "macros/helpers.njk" import spriteTarget -%}
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {% block head_pragma %}{% endblock %}
  <title>{% block title %}{{ meta.title }} {{ title }}{% endblock %}</title>
  {% block head_preconnect %}{% endblock %}
  {% block head_async_scripts %}{% endblock %}
  <script type="module">if (typeof globalThis.Temporal === "undefined") import("https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/global.min.js");</script>
  {% block head_import_stylesheets %}{% endblock %}
  {% block head_scripts %}{% endblock %}
  {% include "shared/fonts.html" %}
  {% include "shared/styles.html" %}
  <link rel="stylesheet" href="{{ "index.css" | assetUrl("stylesheets") }}">
  {% block head_stylesheets %}{% endblock %}
  {% block head_preload %}{% endblock %}
  {% block head_defer_scripts %}{% endblock %}
  {% block head_prefetch %}{% endblock %}
  <meta name="description" content="{{ description or meta.description }}">
  {% block head_meta %}{% endblock %}
  <meta name="robots" content="noindex">
  <meta name="author" content="https://hckr.studio/">
  <meta name="generator" content="{{ generator or meta.generator }}">
  <link rel="author" href="/humans.txt" type="text/plain">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#222222" media="(prefers-color-scheme: dark)">
  {% include "shared/app-icons.html" %}
  {% block sitemanifest %}<link rel="manifest" href="/sitemanifest.json">{% endblock %}
  {% block head %}{% endblock %}
</head>
<body>

<link rel="stylesheet" href="{{ "header.css" | assetUrl("stylesheets") }}">
<nav class="hc-navbar">
  <div class="hc-navbar__logo">
    {% include "shared/logo.html" %}
  </div>
  <div id="hc-header__profile" class="hc-navbar__right">

  </div>
</nav>
<main id="top">
  {% block content %}{% endblock %}
</main>

<footer>
  <p style="text-align: center">© 2021-{{ currentYear }} Hacker camp crew z.s., IČ <a
      href="https://or.justice.cz/ias/ui/rejstrik-firma.vysledky?subjektId=1158268&typ=PLATNY">17130476</a>, DIČ
    CZ17130476;
    <a href="https://www.hlidacshopu.cz/zpracovani-osobnich-udaju/">Zpracování osobních údajů</a></p>
</footer>

<script type="module">
  import { init as initHeader } from "{{ "header.js" | assetUrl("esm") }}";
  import { init as initLayout } from "{{ "layout.js" | assetUrl("esm") }}";

  const build = {{ collections.build | dump(8) | safe }};
  const env = Object.assign({ year: {{ year }} }, build);
  initHeader({
    profile: document.getElementById("hc-header__profile"),
    env,
  });
  initLayout({ snackbar: document.getElementById("hc-snackbar") });
</script>

<article popover="manual" id="hc-snackbar" class="snackbar" role="status">
  <div class="content">
    <p aria-live="polite"></p>
  </div>

  <div class="actions">
    <button class="button" popovertarget="hc-snackbar" popovertargetaction="hide" title="Zavřít">
      <span class="sr-only">Zavřít</span>
      <feather-icon name="x" title="Zavřít"></feather-icon>
    </button>
  </div>
</article>

{% block scripts %}{% endblock %}
{{ spriteTarget() }}
</body>
</html>
