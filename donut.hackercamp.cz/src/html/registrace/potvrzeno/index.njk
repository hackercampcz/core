{% extends "layouts/application.njk" %}

{% block title %}Registrace odeslána{% endblock %}
{% block head %}
  <style>
  </style>
{% endblock %}

{% block content %}
  <div class="hc-code-bg">
    <header id="top" class="hc-hero mdc-layout-grid">
      <div class="mdc-layout-grid__inner">
        <div class="hc-hero__inner mdc-layout-grid__cell mdc-layout-grid__cell--span-12">
          <h1>Odesláno!</h1>
        </div>
      </div>
      <div class="form-story">
        <p>Díky, fakturu odešleme na uvedený kontakt.</p>
      </div>
    </header>
  </div>
{% endblock %}

{% block javascript %}
  <script type="module">
    const url = new URL(location.href);
    if (url.searchParams.has("volunteer")) {
      document.querySelector(".form-story p").textContent = "Díky a budiž ti věčná sláva za tvou pomoc!";
    }
  </script>
{% endblock %}
