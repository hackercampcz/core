{% extends "layouts/application.njk" %}

{% block title %}Převod vstupného Hacker Campu{% endblock %}

{% block head_stylesheets %}
  <style>
    body.modal-view > nav,
    body.modal-view > footer {
      display: none;
    }

    body.modal-view #top {
      padding-top: 0.5lh;
    }

    body.modal-view #view-title {
      margin-inline: auto;
    }

    label + label {
      margin-block: 0.5lh;
    }

    label:has(input[type=radio]),
    label:has(input[name=text]) {
      display: flex;
      gap: 8px;
      justify-content: space-between;
      align-items: baseline;
    }

    label:has(input[type=radio]) {
      justify-content: flex-start;
      align-items: baseline;
      line-height: 2;
    }

    input[name=count] {
      width: 4ch;
    }

    input[name=text] {
      min-width: 20ch;
      width: 100%;
    }

    input[name=price] {
      width: 8ch;
    }
  </style>
{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ 'admin.css' | assetUrl('stylesheets') }}">
{% endblock %}

{% block content %}
  <div id="app-root">
    <h2 id="view-title">
      <span>Převod vstupného</span>
    </h2>
    <form name="transfer" method="dialog">
      <input type="hidden" name="slackID">

      <fieldset id="attendee">
        <legend>Vstupenka</legend>
        <template>
          <label><input type="radio" name="year" value="" required></label>
        </template>
        <div class="options">
          <p>Hledám nepoužitou vstupenku…</p>
        </div>
      </fieldset>
      <button class="hc-button" type="submit">Převést vstupenku</button>
    </form>
  </div>
  <dialog id="modal" class="hc-dialog">
    <div id="modal-root"></div>
    <button class="icon-button" data-action="close" title="Zavřít" aria-label="Zavřít dialogové okno">
      <feather-icon name="x" title="Zavřít"></feather-icon>
    </button>
  </dialog>
{% endblock %}

{% block scripts %}
<script type="module">
  import { main } from "{{ 'transfer.js' | assetUrl('esm') }}";
  const build = {{ collections.build | dump(8) | safe }};
  const event = {{ event | dump(8) | safe }};
  const tickets = {{ ticket | dump(8) | safe }};
  const year = {{ year | safe }};
  const env = Object.assign({ year, event, tickets }, build);
  main({
    searchParams: new URLSearchParams(location.search),
    appRoot: document.getElementById("app-root"),
    viewTitle: document.getElementById("view-title").querySelector("span"),
    env,
  });
</script>
{% endblock %}
