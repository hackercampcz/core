{% extends "layouts/master.njk" %}

{% block title %}Často kladené dotazy na Hacker Camp{% endblock %}

{% block head_stylesheets %}
  <style>
    main {
      margin: 0 auto;
      max-width: var(--hc-layout-width);
    }

    h1 {
      text-align: center;
      margin-top: 2em;
    }

    .hc-card {
      border: 1px solid #f2f2f2;
    }

    [itemtype="https://schema.org/Question"] {
      margin-block: 1lh;
      margin-inline: 2ch;
    }

    [itemtype="https://schema.org/Question"]:target {
      scroll-margin-top: 7em;
    }

    [itemtype="https://schema.org/Question"] [itemprop="name"] {
      padding-right: 48px;
      margin: 0;
    }

    [itemtype="https://schema.org/Question"]:target [itemprop="name"] {
      border-bottom: 1px solid #f2f2f2;
      padding-bottom: 32px;
      margin-bottom: 32px;
    }

    [itemtype="https://schema.org/Question"] [itemtype="https://schema.org/Answer"] {
      display: none;
    }

    [itemtype="https://schema.org/Question"]:target [itemtype="https://schema.org/Answer"] {
      display: block;
    }
  </style>
{% endblock %}

{% block head_meta %}
  <meta
    name="description"
    content="Zažijte netradiční třídenní festival pro lidi z české tech scény. V duchu nekonference či barcampu se od sebe budeme vzájemně učit, bavit se a poznávat.">

  <link rel="canonical" href="https://www.hackercamp.cz/faq/">
{% endblock %}


{% set pageSchema = "FAQPage" %}

{% block navigation %}
  <a class="hc-link hc-navbar__link" href="https://g.page/sobenak?share">Mapa</a>
  <!--a class="hc-link hc-navbar__link" href="/program/">Program</a-->
  <a
    class="hc-link hc-link--decorated"
    href="/registrace/">Chci se zapojit</a>
{% endblock %}

{% block hero %}
  <div class="hc-code-bg">
    <header id="top" class="hc-hero">
      <div class="hc-hero__inner">
        <iframe
          width="720"
          height="405"
          src="https://www.youtube-nocookie.com/embed/7iQTP3IY0-E?hl=cs&modestbranding=1"
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="aspect-ratio: 16/9; width: 100%; height: auto; max-width: 1280px; margin: 0 auto;"></iframe>
        <h1 style="margin-top: 1em">FAQs</h1>
      </div>
    </header>
  </div>
{% endblock %}

{% block content %}
  <div id="faq-1" class="hc-card" itemscope itemtype="https://schema.org/Question">
    <a href="#faq-1"><h2 itemprop="name">Na co se můžu těšit?</h2></a>
    <div itemprop="suggestedAnswer acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
      <div itemprop="text">
        {% markdown "faq/1-na-co-se-muzu-tesit.md" %}
      </div>
    </div>
  </div>

