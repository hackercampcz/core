        </style>
        <div style="display: flex; flex-wrap: wrap; justify-content: space-between">
          {{ image("faq-ubytko-1.jpg", collections.images,
            phoneWidth=200,
            phoneHeight=132,
            tabletWidth=300,
            width=340,
            alt="šestilůžkový pokoj",
            title="pokoj pro šest",
            class="accommodation__image") }}
          {{ image("faq-ubytko-2.jpg", collections.images,
