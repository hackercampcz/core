{% extends "layouts/master.njk" %}
{% from "macros/helpers.njk" import twitterCardImage %}

{% block title %} Hacker Camp{% endblock %}

{% block head_stylesheets %}
  <style>
    .hc-hero {
      display: grid;
      gap: var(--hc-gutter);
      @media screen and (min-width: 640px) {
        grid-template-columns: 1fr 1fr;
      }
    }

    .hc-hero video {
      max-width: calc(100vw - var(--hc-gutter, 16px) * 2);
      @media screen and (min-width: 640px) {
        max-width: 100%;
      }
    }
  </style>
{% endblock %}

{% block head %}
  <meta
    name="description"
    content="Zažijte netradiční třídenní festival pro lidi z české tech scény. V duchu nekonference či barcampu se od sebe budeme vzájemně učit, bavit se a poznávat.">
  {{ twitterCardImage(collections.images["IMG_5429.jpg"]["public_id"]) }}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="canonical" href="https://www.hackercamp.cz/">
{% endblock %}

{% set pageSchema = "Festival" %}

{% block navigation %}
  {% if event.willStartSoon %}
    <a class="hc-link hc-navbar__link" href="/mapa">Navigovat</a>
  {% endif %}
  <a class="hc-link hc-navbar__link" href="/faq/">FAQ</a>
  {% if event.isRegistrationOpen %}
    <a class="hc-link hc-link--decorated" href="/registrace/">Chci se zapojit</a>
  {% endif %}
{% endblock %}

{% block hero %}
  <link itemprop="eventStatus" href="https://schema.org/EventScheduled">
  <link itemprop="eventAttendanceMode" href="https://schema.org/MixedEventAttendanceMode">
  <div class="hc-code-bg">
    <header id="top" class="hc-hero">
      <div class="hc-hero__inner">
        <hgroup>
          <h1 itemprop="name">{{ event.name }}</h1>
          <h2><small>Hack to the Future</small></h2>
        </hgroup>
        {% if not event.willStartSoon %}
          <p itemprop="description">{{ event.details | processTypography("cs") }}</p>
          <p>
            {{ event.startDate | longDate }} &ndash; {{ event.endDate | longDate }}
            {{ event.startDate | year }} na Sobeňáku
          </p>
          {% if event.isRegistrationOpen %}<p><a class="hc-cta" href="/registrace/">Chci se zapojit</a></p>{% endif %}
        {% else %}
          <p>Vjezd do areálu je chráněn značkou zákaz vjezdu. Nelekni se. Ta napovídá správný směr. Pokračuj</p>
          <p><a href="/mapa" class="hc-cta">Navigovat</a></p>
        {% endif %}
      </div>
      <div class="hc-camp-detail">
        {% set publicId = collections.images["header-camp.png"]["public_id"] %}
        <video
          aria-hidden="true"
          class="responsive"
          muted
          autoplay
          loop
          playsinline
          width="622"
          height="622"
          poster='{{ publicId | cloudinaryUrl(width=622,height=622,crop="fill",dpr="auto") }}'>
          <source
            media="screen and (max-width: 599px)"
            type="video/mp4; codecs=av01.0.08M.08.0.110.01.01.01.1"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_480,w_480/f_auto:video,vc_v1,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <source
            media="screen and (max-width: 599px)"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_480,w_480/f_auto:video,vc_auto,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <source
            media="screen and (min-width: 600px) and (max-width: 839px)"
            type="video/mp4; codecs=av01.0.08M.08.0.110.01.01.01.1"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_360,w_360/f_auto:video,vc_av1,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <source
            media="screen and (min-width: 600px) and (max-width: 839px)"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_360,w_360/f_auto:video,vc_auto,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <source
            media="screen and (min-width: 840px)"
            type="video/mp4; codecs=av01.0.08M.08.0.110.01.01.01.1"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_622,w_622/f_auto:video,vc_av1,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <source
            media="screen and (min-width: 840px)"
            src="https://res.cloudinary.com/hackercamp/video/upload/h_622,w_622/f_auto:video,vc_auto,q_auto:eco/v1720011238/www.hackercamp.cz/hackercamp_video_na_web_lxihcf">
          <picture>
            <source
              media="screen and (max-width: 599px)"
              srcset="{{ publicId | cloudinaryUrl(width=480,height=480,dpr=1) }} 1x,
                      {{ publicId | cloudinaryUrl(width=480,height=480,dpr=1.5) }} 1.5x,
                      {{ publicId | cloudinaryUrl(width=480,height=480,dpr=2) }} 2x">
            <source
              media="screen and (min-width: 600px) and (max-width: 839px)"
              srcset="{{ publicId | cloudinaryUrl(width=360,height=360,dpr=1) }} 1x,
                      {{ publicId | cloudinaryUrl(width=360,height=360,dpr=1.5) }} 1.5x,
                      {{ publicId | cloudinaryUrl(width=360,height=360,dpr=2) }} 2x">
            <source
              media="screen and (min-width: 840px)"
              srcset='{{ publicId | cloudinaryUrl(width=622,height=622,crop="fill",dpr=1) }} 1x,
                      {{ publicId | cloudinaryUrl(width=622,height=622,crop="fill",dpr=1.5) }} 1.5x,
                      {{ publicId | cloudinaryUrl(width=622,height=622,crop="fill",dpr=2) }} 2x'>
            <img
              alt=""
              loading="lazy"
              class="responsive"
              width="622"
              height="622"
              src='{{ publicId | cloudinaryUrl(width=622,height=622,crop="fill",dpr="auto") }}'>
          </picture>
        </video>
      </div>
    </header>
  </div>
{% endblock %}

{% block content %}
  <section class="hc-card-grid">
    <div class="hc-card hc-card--decorated">
      <p>Festival, nekonference, kemp. Setkání v&nbsp;přírodě s&nbsp;lidmi, kteří si
        mají co předat.</p>
    </div>
    <div class="hc-card hc-card--decorated">
      <p>Nekomerční, neformální, no-bullshit, no-sales akce.</p>
    </div>
    <div class="hc-card hc-card--decorated">
      <p>250&nbsp;účastníků hlavně z&nbsp;tech scény, kde je každý aktivním tvůrcem
        programu.</p>
    </div>
  </section>

  <section id="co-cekat">
    <h2 id="toc-co-cekat">Co čekat?</h2>
    <div class="hc-card hc-card--centered hc-card--superdecorated">
      <p class="hc-text--gay"><strong><em>Přes den diskuze, workshopy, exkluzivní program,
            sport i&nbsp;relax. Večer koncerty, party a&nbsp;DJs.</em></strong></p>

      <p>V&nbsp;duchu nekonference či barcampu se od sebe vzájemně učíme, společně
        se bavíme a poznáváme, dohromady kemp tvoříme. Každý je aktivním
        tvůrcem kempu, nerozdělujeme speakery a účastníky. Chceme, ať jsme na
        kempu co nejvíc v&nbsp;přítomnosti, přitom tvořit lepší budoucnost. Jaké si
        to uděláme, takové to bude, a to platí jak pro kemp tak budoucnost. Večer
        patří kapelám, DJs a&nbsp;párty.</p>

      <p><strong>Poznejte lidi, které chcete znát, pojďte společně hacknout
          budoucnost.</strong></p>
    </div>
  </section>

  <section id="koho">
    <h2 id="toc-koho-potkas">Koho potkáš?</h2>
    <div class="hc-card">
      <p>Fajn lidi, hlavně z&nbsp;české tech scény a spřátelených neziskovek.
        Hacker Camp je jen pro zvané a každý za své pozvané ručí. Kapacita je
        tři stovky, ale areál je obrovský a kemp je skvělý pro introverty.</p>
      <p>Hacker Camp je o&nbsp;lidech, chceme jej strávit s&nbsp;kamarády a těmi, které za
        kamarády chceme. Roli nehraje status, ale osobnost - <strong>nechceme kretény</strong>.</p>
    </div>
    <div class="hc-card hc-card--flat">
      <p>Každý účastník kempu je zároveň jeho tvůrcem, po každém požadujeme
        zapojení, ať již v&nbsp;programu nebo v&nbsp;pomoci s&nbsp;akcí samotnou.</p>
      <p>Akce není jen pro vývojáře, nejde o&nbsp;hackathon. Hacker je pro nás
        někdo, kdo hledá nové způsoby, chce stavět nebo zažít něco nového.</p>
    </div>
  </section>

  <section id="pro-koho">
    <h2 id="toc-pro-koho">Pro koho?</h2>
  </section>
  <div class="hc-people-bg hc-people-section">
    <div class="hc-card">
      <p>Kdo jsou hackeři, se kterými se potkáš? Majitelé firem, investoři,
        programátoři a dataři, NGOs, NPOs a další social justice warriors, bio
        hacking nadšenci a otužilci&nbsp;&ndash; prostě lidi jako&nbsp;ty.</p>
      <p>
        Předchozí ročníky si užili holky a kluci například z&nbsp;<span
          itemprop="organizer"
          typeof="Organization"><a itemprop="sameAs" href="https://apify.com/">Apify</a></span>,
        <span itemprop="organizer" typeof="Organization"><a
            itemprop="sameAs"
            href="https://hckr.studio/">hckr.studio</a></span>,
        <span itemprop="organizer" typeof="Organization"><a
            itemprop="sameAs" href="https://www.fenekpr.cz/">Fenek</a
          ></span>,
        <span itemprop="organizer" typeof="Organization"><a
            itemprop="sameAs"
            href="https://www.czechitas.cz/">Czechitas</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs" href="https://www.hlidacstatu.cz/">Hlídač
              Státu</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://www.mavericks.legal/">Mavericks</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://www.reflexcapital.com/">Reflex Capital</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://carldatacompany.com/">Carl</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://www.bizmachine.com/">BizMachine</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://www.csas.cz/">Česká spořitelna</a
          ></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs" href="https://www.heureka.cz/">Heureka</a
          ></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://applifting.io/">Applifting</a></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs" href="https://keboola.com/">Keboola</a
          ></span>,
        <span itemprop="attendee" typeof="Organization"><a
            itemprop="sameAs"
            href="https://cesko.digital/">česko.digital</a></span>.
      </p>
    </div>
  </div>
  <div class="hc-grey-bg">
    <section id="obsah-campu">
      <h2 id="toc-kazdy-z-nas-tvori-obsah-campu">
        Každý z nás tvoří obsah campu
      </h2>
      <div class="hc-card-grid">
        <div class="hc-card hc-card--decorated">
          <p>Každý účastník je zároveň tvůrce akce. Od každého čekáme aktivní
            zapojení podle vlastních možností.</p>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["A7R04297.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["IMG_5182.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["IMG_6026.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--decorated">
          <p>
            Můžeš přispět přednáškou, workshopem, naštípat dřevo, přivést legacy hrací konzoli, deskovku, zorganizovat
            ranní výběh nebo turnaj v&nbsp;jakémkoliv sportu.
          </p>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["IMG_6916_1.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["NM6A4967.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--picture hc-card--centered">
          {% set publicId = collections.images["NM6A4775.jpg"]["public_id"] %}
          <img
            class="responsive"
            loading="lazy"
            alt=""
            width="500"
            height="281"
            src='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="auto") }}'
            srcset='{{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1") }} 1x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="1.5") }} 1.5x,
                  {{ publicId | cloudinaryUrl(width=500, height=281, crop="fill", dpr="2") }} 2x'>
        </div>
        <div class="hc-card hc-card--decorated">
          <p>Účastníci většinou trpí FOMO, protože je toho v&nbsp;nabídce strašně moc.
            Zvaž svou participaci na programu s&nbsp;více lidma na něčem, co tu ještě
            nebylo. Pojďme společně zvednout laťku kvality někam pod&nbsp;bradu.</p>
        </div>
      </div>
    </section>
    <section id="kdy">
      <div class="hc-card hc-card--flat">
        <h2 id="toc-kdy-prijet">
          <svg
            aria-hidden="true"
