              fill="#fff"
            />
            <path
              d="M34.1 52.4h3c.9 0 1.6-.7 1.6-1.6V49c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6zM46 52.4h3c.9 0 1.6-.7 1.6-1.6V49c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6zM57.9 52.4h3c.9 0 1.6-.7 1.6-1.6V49c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6zM34.1 61h3c.9 0 1.6-.7 1.6-1.6v-1.8c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6zM46 61h3c.9 0 1.6-.7 1.6-1.6v-1.8c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6zM57.9 61h3c.9 0 1.6-.7 1.6-1.6v-1.8c0-.9-.7-1.6-1.6-1.6h-3c-.9 0-1.6.7-1.6 1.6v1.8c0 .9.7 1.6 1.6 1.6z"
