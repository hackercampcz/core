        <p>
          Začínáme ve čtvrtek
          <time itemprop="startDate"
                datetime="{{ event.startDate | isoDate }}">{{ event.startDate | longDate }}</time>
          a končíme v&nbsp;neděli
          <time itemprop="endDate" datetime="{{ event.endDate | isoDate }}">{{ event.endDate | longDate }}</time>
          v&nbsp;poledne, hned jak se proberete po good-bye&nbsp;party.
        </p>
        <p style="margin: 2em 0 0">
          <a
            class="hc-icon-link"
            href="{{ event | calendarURL }}">
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="16"
              height="16">
              <path d="M0 0h24v24H0z" fill="none"/>
              <path
                d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19a2 2 0 002 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"
